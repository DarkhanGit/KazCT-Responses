 * Проект AP25796141, КАТИУ им. С. Сейфуллина.
 *
 * Как запустить: script.google.com → Новый проект → вставить этот код → выбрать функцию createBothForms → ▶ Выполнить
 * → разрешить доступ. Ссылки на формы появятся в журнале выполнения (Ctrl+Enter) и в Google Диске.
 *
 * Что скрипт НЕ умеет (сделать вручную после создания, 2 минуты):
 *   – «Перемешать варианты» для D1–D6 (⋮ у вопроса → Перемешать варианты) — в API нет.
 *   – вписать названия школ в A2 (сейчас три заглушки).
 */

var SCHOOLS = ["Школа 1", "Школа 2", "Школа 3"];  // заменить на реальные названия

function createBothForms() {
  var ru = createForm_(RU_);
  var kz = createForm_(KZ_);
  Logger.log("RU: редактирование " + ru.getEditUrl() + "\n    для учеников " + ru.getPublishedUrl());
  Logger.log("KZ: редактирование " + kz.getEditUrl() + "\n    для учеников " + kz.getPublishedUrl());
}

function createForm_(T) {
  var f = FormApp.create(T.title);
  f.setTitle(T.title).setDescription(T.intro)
   .setCollectEmail(false).setShuffleQuestions(false).setProgressBar(true)
   .setAllowResponseEdits(false).setLimitOneResponsePerUser(false)
   .setConfirmationMessage(T.thanks);

  // ---------- A
  section_(f, T.secA);
  var a1 = f.addTextItem().setTitle(T.a1).setHelpText(T.a1help).setRequired(true);
  a1.setValidation(FormApp.createTextValidation().setHelpText(T.a1err)
     .requireTextMatchesPattern("^[0-9]{2}-[0-9]{2}-[0-9]{2}$").build());
  f.addListItem().setTitle(T.a2).setChoiceValues(SCHOOLS).setRequired(true);
  f.addMultipleChoiceItem().setTitle(T.a3).setChoiceValues(["9", "10", "11"]).setRequired(true);
  f.addMultipleChoiceItem().setTitle(T.a4).setChoiceValues(T.a4opts).setRequired(true);
  f.addMultipleChoiceItem().setTitle(T.a5).setChoiceValues(T.a5opts).setRequired(true);
  f.addMultipleChoiceItem().setTitle(T.a6).setChoiceValues(T.a6opts).setRequired(true);
  f.addCheckboxItem().setTitle(T.a7).setChoiceValues([T.a7opt]).setRequired(true);
  f.addMultipleChoiceItem().setTitle(T.a8).setHelpText(T.optional).setChoiceValues(T.a8opts).setRequired(false);

  // ---------- B
  section_(f, T.secB);
  f.addGridItem().setTitle(T.b1).setHelpText(T.b1help).setRows(T.interests).setColumns(["1", "2", "3", "4", "5"]).setRequired(true);
  var b2 = f.addCheckboxItem().setTitle(T.b2).setChoiceValues(T.formats).setRequired(true);
  b2.setValidation(FormApp.createCheckboxValidation().setHelpText(T.b2err).requireSelectAtMost(4).build());
  f.addGridItem().setTitle(T.b3).setHelpText(T.b3help).setRows(T.mot).setColumns(["1", "2", "3", "4", "5"]).setRequired(true);
  f.addTextItem().setTitle(T.b4).setHelpText(T.optional).setRequired(false);

  // ---------- C
  section_(f, T.secC);
  f.addGridItem().setTitle(T.c1).setHelpText(T.c1help).setRows(T.cog).setColumns(["1", "2", "3", "4", "5"]).setRequired(true);

  // ---------- D
  section_(f, T.secD);
  T.d.forEach(function (q) {
    f.addMultipleChoiceItem().setTitle(q[0]).setHelpText(q[1]).setChoiceValues(q[2]).setRequired(true);
  });

  // ---------- E
  section_(f, T.secE);
  T.e.forEach(function (q) {
    var it = f.addParagraphTextItem().setTitle(q).setHelpText(T.ehelp).setRequired(true);
    it.setValidation(FormApp.createParagraphTextValidation().setHelpText(T.eerr)
       .requireTextLengthGreaterThanOrEqualTo(150).build());
  });

  // ---------- F
  section_(f, T.secF);
  f.addScaleItem().setTitle(T.f1).setBounds(1, 5).setLabels(T.f1lo, T.f1hi).setRequired(true);
  f.addParagraphTextItem().setTitle(T.f2).setHelpText(T.optional).setRequired(false);
  return f;
}

function section_(f, s) { f.addPageBreakItem().setTitle(s[0]).setHelpText(s[1] || ""); }

